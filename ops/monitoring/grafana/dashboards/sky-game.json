{
  "uid": "sky-service-game",
  "title": "Sky · Game 모니터링",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "sky"
  ],
  "editable": false,
  "description": "HTTP/API/게임 통계 관찰과 AWS/ECS 지표. No data는 미설정·수집 실패 확인 필요. k6 실시간 지표와 단계별 성능은 미연동.",
  "refresh": "30s",
  "timezone": "browser",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "region",
        "type": "textbox",
        "query": "ap-northeast-2",
        "current": {
          "text": "ap-northeast-2",
          "value": "ap-northeast-2"
        },
        "label": "region"
      },
      {
        "name": "sky_cluster",
        "type": "textbox",
        "query": "SET_SKY_CLUSTER",
        "current": {
          "text": "SET_SKY_CLUSTER",
          "value": "SET_SKY_CLUSTER"
        },
        "label": "sky_cluster"
      },
      {
        "name": "sky_service",
        "type": "textbox",
        "query": "SET_SKY_SERVICE",
        "current": {
          "text": "SET_SKY_SERVICE",
          "value": "SET_SKY_SERVICE"
        },
        "label": "sky_service"
      },
      {
        "name": "game_cluster",
        "type": "textbox",
        "query": "SET_GAME_CLUSTER",
        "current": {
          "text": "SET_GAME_CLUSTER",
          "value": "SET_GAME_CLUSTER"
        },
        "label": "game_cluster"
      },
      {
        "name": "game_service",
        "type": "textbox",
        "query": "SET_GAME_SERVICE",
        "current": {
          "text": "SET_GAME_SERVICE",
          "value": "SET_GAME_SERVICE"
        },
        "label": "game_service"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "수집기 상태 (1=정상)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "sky-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"sky-observer\"}",
          "legendFormat": "{{target}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "관찰 대상 수",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "sky-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sky_observer_targets",
          "legendFormat": "{{target}} {{status}}"
        }
      ],
      "fieldConfig": {
