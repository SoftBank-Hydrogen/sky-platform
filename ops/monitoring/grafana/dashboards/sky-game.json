    {
      "id": 15,
      "title": "Sky ECS CPU — AWS 연결 후 표시",
      "type": "timeseries",
      "datasource": {
        "type": "cloudwatch",
        "uid": "sky-cloudwatch"
      },
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "sky-cloudwatch"
          },
          "queryMode": "Metrics",
          "namespace": "AWS/ECS",
          "metricName": "CPUUtilization",
          "region": "$region",
          "statistic": "Average",
          "period": "60",
          "dimensions": {
            "ClusterName": "$sky_cluster",
            "ServiceName": "$sky_service"
          },
          "matchExact": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      }
    },
